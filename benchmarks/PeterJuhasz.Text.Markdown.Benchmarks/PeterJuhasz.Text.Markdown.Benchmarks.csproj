<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>PeterJuhasz.Text.Markdown.Benchmarks</RootNamespace>

		<IsPackable>false</IsPackable>
		<IsPublishable>false</IsPublishable>
	</PropertyGroup>

	<PropertyGroup>
		<!-- BenchmarkDotNet refuses to run a non optimized build, and warns about instance members which could be static -->
		<Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
		<NoWarn>$(NoWarn);CA1822</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" Version="*" />
		<PackageReference Include="Markdig.Signed" Version="1.3.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\PeterJuhasz.Text.Markdown\PeterJuhasz.Text.Markdown.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Sample.md" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
